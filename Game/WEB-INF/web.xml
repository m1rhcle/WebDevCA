<?xml version="1.0" encoding="ISO-8859-1"?>
<web-app xmlns="http://java.sun.com/xml/ns/j2ee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd"
    version="2.4">
	
	
	
	<servlet>
        <servlet-name>LandingPage</servlet-name>
        <servlet-class>Landing</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LandingPage</servlet-name>
        <url-pattern>/landing</url-pattern>
    </servlet-mapping>
	
	
    <servlet>
        <servlet-name>RegisterPage</servlet-name>
        <servlet-class>Register</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterPage</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>



    <servlet>
        <servlet-name>LoginPage</servlet-name>
        <servlet-class>Login</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginPage</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
	
	<servlet>
		<servlet-name>ACshopPage</servlet-name>
		<servlet-class>ACshop</servlet-class>
    </servlet>
	
	<servlet-mapping>
		<servlet-name>ACshopPage</servlet-name>
		<url-pattern>/ACshop</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>MysticalYokaiPage</servlet-name>
		<servlet-class>MywShop</servlet-class>
    </servlet>
	
	<servlet-mapping>
		<servlet-name>MysticalYokaiPage</servlet-name>
		<url-pattern>/MywShop</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>AbyssalAngelPage</servlet-name>
		<servlet-class>AAshop</servlet-class>
    </servlet>
	
	<servlet-mapping>
		<servlet-name>AbyssalAngelPage</servlet-name>
		<url-pattern>/AAshop</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>AQWorlds</servlet-name>
		<servlet-class>AQWorlds</servlet-class>
    </servlet>
	
	<servlet-mapping>
		<servlet-name>AQWorlds</servlet-name>
		<url-pattern>/AQWorlds</url-pattern>
	</servlet-mapping>
	


</web-app>
